{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(node --test*)",
      "Bash(git diff*)",
      "Bash(git status)",
      "Bash(git log*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(wc:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(git push --force*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CODEBUDDY_PROJECT_DIR\"/.codebuddy/hooks/guard-bash.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
