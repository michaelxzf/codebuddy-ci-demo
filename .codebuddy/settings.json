{
  "permissions": {
    "allow": ["Bash(npm test)", "Bash(node --test*)", "Bash(git diff*)", "Bash(git status)", "Bash(git log*)"],
    "deny": ["Read(./.env)", "Bash(git push --force*)"]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "\"$CODEBUDDY_PROJECT_DIR\"/.codebuddy/hooks/guard-bash.sh", "timeout": 15 } ] }
    ]
  }
}
